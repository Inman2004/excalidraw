{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperimo",
  "version": "0.1.0",
  "identifier": "io.github.inman2004.paperimo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Paperimo",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "dragDropEnabled": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "moon",
    "copyright": "© 2026 moon. Drawing engine: Excalidraw (MIT).",
    "shortDescription": "Notepad-like sketchbook built on Excalidraw",
    "longDescription": "Paperimo is an unofficial, independent desktop app built on the open-source Excalidraw engine. It is not affiliated with or endorsed by Excalidraw.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["excalidraw"],
        "name": "Excalidraw drawing",
        "mimeType": "application/vnd.excalidraw+json",
        "role": "Editor"
      }
    ]
  }
}
